NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://prayerhub:prayerhub@localhost:5432/prayerhub
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=

# Live audio (LiveKit Cloud or self-hosted — https://livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Bible integration — defaults to the public-domain provider (bible-api.com, KJV,
# no key needed) if BIBLE_PROVIDER is unset. Set to api_bible for a licensed
# translation via scripture.api.bible.
BIBLE_PROVIDER=public_domain
BIBLE_API_KEY=
BIBLE_ID=
BIBLE_TRANSLATION_NAME=

# Object storage for audio posts/testimonies (S3-compatible — AWS S3, Cloudflare R2,
# Backblaze B2, or local MinIO for dev)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=prayerhub-media
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# AI Assistant (Anthropic) — required for /assistant/* and AI-assisted report triage
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-4-5

# Semantic search embeddings (Voyage AI — Anthropic's recommended embeddings
# partner). Optional: without this, /search/prayers falls back to keyword search.
VOYAGE_API_KEY=
